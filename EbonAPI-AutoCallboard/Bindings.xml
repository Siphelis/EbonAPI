<Bindings>
	<Binding name="AUTOCALLBOARD_ECHO1" header="AutoCallboard">
		if AutoCallboardRuntime then AutoCallboardRuntime.TriggerEchoSlot(1) end
	</Binding>
	<Binding name="AUTOCALLBOARD_ECHO2">
		if AutoCallboardRuntime then AutoCallboardRuntime.TriggerEchoSlot(2) end
	</Binding>
	<Binding name="AUTOCALLBOARD_ECHO3">
		if AutoCallboardRuntime then AutoCallboardRuntime.TriggerEchoSlot(3) end
	</Binding>
</Bindings>
